# Copy to .env for local work. On Coolify, set these in Environment Variables
# and tick "Available at Buildtime" (they are baked into the build).

# Which environment this build is for: development | staging | production
# Staging app (branch: staging)  -> staging
# Production app (branch: master) -> production
VITE_APP_ENV=development

# Build target for Coolify (leave as is)
NITRO_PRESET=node-server
